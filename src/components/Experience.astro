---
const experiences = [
  {
    period: "2025 — Present",
    role: "Co-founder & CTO",
    company: "UPoints",
    location: "Cuenca, Ecuador (Remote)",
    type: "full-time",
    description:
      "Leading the technical strategy and development of a SaaS platform for digitizing loyalty programs. Designed a modular platform using NestJS and PostgreSQL, aligned with business goals for market launch. Optimized API performance by 40% using Redis for caching and session management under high concurrency. Built a responsive frontend with React and Next.js, implementing Server-Side Rendering (SSR) for SEO and speed.",
    tags: ["NestJS", "React", "Next.js", "PostgreSQL", "Redis", "SSR"],
  },
  {
    period: "2021 — Present",
    role: "Software Engineer / Tech Lead",
    company: "Rappi",
    location: "Remote",
    type: "full-time",
    description:
      "Rapidly promoted through three roles due to technical excellence and impact on the 'Super App' ecosystem. Currently Tech Lead on the Compensations Team, leading technical decisions and mentoring developers. Architect and maintain critical internal tools, streamlining financial operations. Previously built robust backend services with Kotlin, Go, and Node.js, integrating Kafka for real-time event processing. Optimized PostgreSQL queries for high-volume support data. Developed high-performance web apps with React and Node.js, implementing micro-frontends and improving Core Web Vitals through server-side caching and service workers.",
    tags: ["Kotlin", "Go", "Node.js", "Kafka", "PostgreSQL", "React", "Micro-frontends"],
  },
  {
    period: "2020 — 2021",
    role: "Lead Software Developer",
    company: "Exmerdev",
    location: "Ecuador",
    type: "full-time",
    description:
      "Led the full-stack development of internal tools and client projects, overseeing technical delivery. Developed a real-time platform using WebSockets for instant user communication. Implemented high-conversion landing pages using Gatsby (SSG) and React.js. Collaborated on full-stack web applications, ensuring responsive design and functionality.",
    tags: ["React", "Gatsby", "WebSockets", "Node.js", "Full-stack"],
  },
  {
    period: "2020 — 2021",
    role: "Software Developer",
    company: "Freelance",
    location: "Loja, Ecuador",
    type: "contract",
    description:
      "Built full-stack web applications using the MERN stack (MongoDB, Express, React, Node.js) and PostgreSQL. Deployed serverless architectures on Firebase and containerized applications with Docker.",
    tags: ["MERN", "PostgreSQL", "Firebase", "Docker", "Node.js"],
  },
];
---

<section id="experience" class="experience">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-eyebrow">experience</span>
      <h2 class="section-title">Where I've built</h2>
      <p class="section-subtitle">A trajectory from builder to leader — every role added a new layer of technical depth and ownership.</p>
    </div>

    <div class="timeline">
      {experiences.map((exp, i) => (
        <div class="timeline-item reveal">
          <div class="timeline-marker">
            <div class="timeline-dot"></div>
            {i < experiences.length - 1 && <div class="timeline-line"></div>}
          </div>

          <div class="timeline-card">
            <div class="card-header">
              <div class="card-meta">
                <span class="card-period">{exp.period}</span>
                <span class="card-type">{exp.type}</span>
              </div>
              <h3 class="card-role">{exp.role}</h3>
              <p class="card-company">{exp.company} <span class="card-location">— {exp.location}</span></p>
            </div>

            <p class="card-description">{exp.description}</p>

            <div class="card-tags">
              {exp.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience {
    padding: 120px 0;
    position: relative;
  }

  .section-header {
    margin-bottom: 72px;
    max-width: 640px;
  }

  .section-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-copper);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 16px;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--text-primary);
    margin-bottom: 16px;
  }

  .section-subtitle {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .timeline-item {
    display: flex;
    gap: 24px;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 24px;
    padding-top: 4px;
  }

  .timeline-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-copper);
    box-shadow: 0 0 0 4px rgba(212, 165, 116, 0.15);
    flex-shrink: 0;
  }

  .timeline-line {
    width: 1px;
    flex: 1;
    background: var(--border-subtle);
    margin-top: 12px;
    min-height: 48px;
  }

  .timeline-card {
    flex: 1;
    padding: 28px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    transition: border-color 0.2s ease;
  }

  .timeline-card:hover {
    border-color: rgba(212, 165, 116, 0.3);
  }

  .card-header {
    margin-bottom: 16px;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .card-period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-copper);
  }

  .card-type {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border: 1px solid var(--border-subtle);
    border-radius: 3px;
  }

  .card-role {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    margin-bottom: 4px;
  }

  .card-company {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .card-location {
    color: var(--text-muted);
  }

  .card-description {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    padding: 4px 10px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    border-radius: 3px;
  }

  @media (max-width: 640px) {
    .timeline-item {
      gap: 16px;
    }

    .timeline-card {
      padding: 20px;
    }
  }
</style>
